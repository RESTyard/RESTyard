@{
    var parameterExpression = IsUpload
        ? string.IsNullOrEmpty(ParameterName)
            ? "[HypermediaUploadParameterFromForm] HypermediaFileUploadActionParameter parameters"
            : $"[HypermediaUploadParameterFromForm] HypermediaFileUploadActionParameter<{ParameterName}> parameters"
        : string.IsNullOrEmpty(ParameterName)
            ? ""
            : $"[FromBody] {ParameterName} {RazorTemplateBase.Uncapitalize(ParameterName)}";
}

public Task@("<IActionResult>") @(Name)Async(@(parameterExpression))
{
    throw new NotImplementedException();
}

@code {
    [Parameter] public string Name { get; set; } = null!;
    [Parameter] public string? ParameterName { get; set; }
    [Parameter] public bool IsUpload { get; set; }
}