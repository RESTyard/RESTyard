        (IsUpload: true, ParameterName: var parameter) => $"[HypermediaUploadParameterFromForm] HypermediaFileUploadActionParameter<{parameter}> parameters",
        (IsUpload: false, ParameterName: null or "") => "",
        (IsUpload: false, ParameterName: var parameter) => $"[{nonUploadFromFormAttribute}] {parameter} {RazorTemplateBase.Uncapitalize(parameter)}",
    };
}

public Task@("<IActionResult>") @(Name)Async(@(parameterExpression))
