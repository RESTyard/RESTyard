@{
    var newText = HasNewKeyword ? "new " : "";
    var requiredText = HasRequiredKeyword ? "required " : "";
}

public @newText@requiredText@TypeName @PropertyName { get; set; }
@code {
    [Parameter] public string TypeName { get; set; } = "";
    [Parameter] public string PropertyName { get; set; } = "";
    [Parameter] public bool HasNewKeyword { get; set; } = false;
    [Parameter] public bool HasRequiredKeyword { get; set; } = false;
}
