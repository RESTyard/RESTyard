<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--General settings-->

        <VersionSuffixLocal></VersionSuffixLocal>
        <!--When variable is set we are building a prerelease package-->
        <VersionSuffixLocal Condition="'$(IsPreRelease)'!='' AND  '$(IsPreRelease)'">
            $(VersionSuffix)
        </VersionSuffixLocal>

        <Version>1.0.0$(VersionSuffixLocal)</Version>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Descriptions and information-->
        <Titel>RESTyard Schema</Titel>
        <PackageDescription>Schema model for RESTyard hypermedia APIs. Describes entity types, links, actions, and embedded entities for documentation, client generation, and tooling.</PackageDescription>
        <PackageTags>Schema REST Siren Hypermedia</PackageTags>
        <Authors>Mathias Reichardt</Authors>
        <Copyright>Copyright 2001-2026 RESTyard Team</Copyright>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/RESTyard/RESTyard</PackageProjectUrl>
        <RepositoryType>Git</RepositoryType>
        <RepositoryUrl>https://github.com/RESTyard/RESTyard.git</RepositoryUrl>
        <RepositoryBranch>$(BranchName)</RepositoryBranch>
        <PackageIcon>Ry-Icon_128x128.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Package specific settings -->
        <PackageVersion>$(Version)</PackageVersion>
        <PackageReleaseNotes>Version $(Version)</PackageReleaseNotes>
        <IsPackable>true</IsPackable>
        <Description></Description>

    </PropertyGroup>

    <!-- package image -->
    <ItemGroup>
        <None Include=".\Images\Ry-Icon_128x128.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
        <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
        <PackageReference Include="JsonSchema.Net.Generation" Version="5.1.1" />
        <PackageReference Include="System.Text.Json" Version="9.0.0" />
    </ItemGroup>
</Project>
